/* %% choosing among values */

FuzzyChoice {
    height: auto;
}

FuzzyChoice OptionList {
    height: auto;
    max-height: 10;
}

/* %% parameter forms */

ActionForm,
ParameterForm,
ParameterField {
    height: auto;
}

ActionForm .parameters {
    height: auto;
    padding-left: 2;
}

.parameter-label {
    margin-top: 1;
    text-style: bold;
}

.coordinates {
    height: auto;
}

.coordinates Label {
    padding: 1 1 0 1;
}

.coordinates Input {
    width: 12;
}

/* %% action screen */

#action-form {
    layout: horizontal;
    height: 1fr;
    width: 2fr;
}

#action-form > .builder-choice {
    width: 40;
    height: 1fr;
}

#action-form > .builder-choice OptionList {
    height: 1fr;
    max-height: 100%;
}

#action-form > .parameters {
    height: 1fr;
}

#log {
    width: 1fr;
    border-left: solid $primary;
}

#status {
    height: auto;
    padding: 0 1;
    background: $boost;
}

/* %% setup screen */

#setup {
    padding: 1 2;
}

#setup-problem {
    color: $error;
    margin: 1 0;
}
